# 本地配置模板：复制为 .env 后填写；已有 .env 时保留本地值。
# Spring Boot 从进程工作目录读取 .env；UTF-8、Java Properties 格式。
# 每行 KEY=value，不写 export，不给值加引号，注释单独占一行。
# 反斜杠需写成两个反斜杠；详细格式和覆盖顺序见 README.md。
# 凭据保持为空，不把真实密码、API Key 或 Token 写入此模板。

# HTTP 服务
SERVER_PORT=8080

# MySQL：先手动执行 deploy/mysql/schema.sql；覆盖 URL 时保留 UTC 参数。
DB_URL=jdbc:mysql://localhost:3306/ai_item_summary?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=
DB_PASSWORD=

# Spring AI：默认关闭；启用时改为 openai 并填写本地 API Key。
SPRING_AI_MODEL_CHAT=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# RAG 构建默认关闭；已提供本地 TXT/Markdown/DOCX 生产解析器与 TokenBudgetKnowledgeChunker（FLAT 与 PARENT_CHILD 模式）。
# 开启 RAG（APP_KNOWLEDGE_RAG_ENABLED=true）会自动装配 TXT/MD/DOCX 解析；PDF 解析使用云端阿里云文档智能且默认关闭。
# 启用构建仍需显式配置 OpenAI Embedding 和 Qdrant，缺少外部后端依赖时拒绝启动；聊天模型可继续关闭。
APP_KNOWLEDGE_RAG_ENABLED=false
SPRING_AI_MODEL_EMBEDDING=none
SPRING_AI_VECTORSTORE_TYPE=none
# Embedding 单独凭据留空时回退到 OPENAI_API_KEY；维度留空采用模型默认维度。
OPENAI_EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=
# Qdrant 使用 gRPC 端口；集合必须与模型维度一致，初始化默认关闭。
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_USE_TLS=false
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_chunks
QDRANT_INITIALIZE_SCHEMA=false
# 固定编排批次与 Token 预算切分选项（基于本地 CL100K_BASE 计数）。
# 数据库批次以整组为单位不拆父子关系，向量只写 RETRIEVAL 并独立按批次大小发送。
RAG_BATCH_SIZE=128
RAG_CHUNK_SIZE=512
# 父块目标尺寸上限（Token），必须 >= RAG_CHUNK_SIZE。
RAG_PARENT_CHUNK_SIZE=2048
# 子块重叠目标尺寸（Token），必须满足 0 <= RAG_CHUNK_OVERLAP < RAG_CHUNK_SIZE。
RAG_CHUNK_OVERLAP=0
RAG_MIN_CHUNK_SIZE_CHARS=200
# 首版只允许 0，防止静默丢弃短文本。
RAG_MIN_CHUNK_LENGTH_TO_EMBED=0
RAG_MAX_NUM_CHUNKS=100000
RAG_KEEP_SEPARATOR=true
# Java Properties 的 \n 在加载后表示换行标点。
RAG_PUNCTUATION_MARKS=.?!;。？！；\n

# 阿里云文档智能（Document Mind）：PDF 解析（含扫描件 OCR 与版面分析）云端网关，默认关闭。
# 仅在 APP_KNOWLEDGE_RAG_ENABLED=true 且 APP_KNOWLEDGE_DOCMIND_ENABLED=true 时装配并上传 PDF 至云端。
# 处理会消耗云服务额度并可能产生费用；启用时必须填写 AccessKey ID 与 AccessKey Secret。
APP_KNOWLEDGE_DOCMIND_ENABLED=false
ALIYUN_DOCMIND_ACCESS_KEY_ID=
ALIYUN_DOCMIND_ACCESS_KEY_SECRET=
ALIYUN_DOCMIND_ENDPOINT=docmind-api.cn-hangzhou.aliyuncs.com
# 视觉大模型增强（VLM）：云解析启用时默认开启，可能增加单页解析费用与耗时。
ALIYUN_DOCMIND_VLM_ENHANCEMENT=true
# 公式识别增强：默认关闭。
ALIYUN_DOCMIND_FORMULA_ENHANCEMENT=false
# 云端轮询时限与间隔：时限范围 1ms～1h（默认 600s）；轮询间隔范围 1ms～1min（默认 2s）。
ALIYUN_DOCMIND_WAIT_TIMEOUT=600s
ALIYUN_DOCMIND_POLL_INTERVAL=2s

# 模拟请求身份：用户 CRUD 不受此开关保护；文件接口需要身份。
# 启用时用户 ID 裁剪后非空且最多 64 个 Unicode 码点；补充平面字符计 1。
# 关闭时不校验未使用的 ID 长度；内部文件服务显式 ID 不裁剪或截断。
APP_AUTH_MOCK_ENABLED=true
APP_AUTH_MOCK_USER_ID=mock-user
APP_AUTH_MOCK_USERNAME=mock-user

# 上传限制：请求大小包含 multipart 额外开销，上传恰好 20MB 时增大请求上限。
APP_FILE_MAX_SIZE=20MB
APP_FILE_REQUEST_MAX_SIZE=20MB
# Tomcat multipart 单个 part 的头部上限；容纳 UTF-8 长文件名，仍保留有限预算。
APP_FILE_MAX_PART_HEADER_SIZE=4KB

# 对象存储公共配置：下载期限为整数秒，范围 1s～7d。
# Key 为前缀/UTC日期/UUID.小写扩展名，原始名称仅保存为元数据，不截断。
# 前缀规范化后 1～150 字符；新 Key 最多 512 长度、1023 UTF-8 字节，每段最多 255 字节。
# 多级前缀逐段校验，超限在首次读流前拒绝。
FILE_STORAGE_KEY_PREFIX=files
FILE_STORAGE_DOWNLOAD_URL_EXPIRATION=15m
FILE_STORAGE_CONNECT_TIMEOUT=5s
FILE_STORAGE_READ_TIMEOUT=60s
FILE_STORAGE_WRITE_TIMEOUT=60s

# MinIO：默认关闭；启用时填写 endpoint、bucket 和凭据，事先创建 Bucket。
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PATH_STYLE_ACCESS=true

# 阿里云 OSS：默认关闭；启用时填写 endpoint、bucket 和凭据。
# 新 Key 为 item/项目名/公共前缀/UTC日期/UUID.扩展名；首尾斜杠会去掉，旧 Key 按记录值访问。
# 默认跟随 spring.application.name（当前 ai-item-summary），也可直接填写固定项目目录。
ALIYUN_OSS_KEY_PREFIX=item/${spring.application.name}
ALIYUN_OSS_ENABLED=false
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=

# 可选真实 MySQL 验收：以下仅为填写参考，必须设置为进程环境变量。
# .env 导入不会设置 System.getenv()；普通 mvn clean verify 使用独立 H2。
# 测试库名必须以 _test 结尾，URL 保留 UTC 参数；不要指向业务数据库。
# USER_TEST_DB_URL=
# USER_TEST_DB_USERNAME=
# USER_TEST_DB_PASSWORD=
